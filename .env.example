# TianXi_AM 环境变量模板
#
#   cp .env.example .env   # 然后填真值；.env 已在 .gitignore 里
#
# 原则：**这里只放密钥、端点、路径与进程形态，不放阈值**。
# §15 要求所有阈值 / 权重 / 消融开关都是配置项——它们属于 configs/*.yaml，
# 不属于环境变量，否则 §12.1 R1 的模型切换会变成改 shell 脚本。
#
# ⚠ **全包只有 src/tianxi_am/common/config.py 读环境变量**（2026-09-24 起）。
#   这一条有静态测试钉住（tests/test_config.py::test_only_config_reads_the_environment），
#   所以**在别处再读一次会被测试拦下**，而不是靠自觉。
#   ⇒ 本文件的变量名与 config.py 的 ENV_* 常量一一对应，改这里要同步改那边。

# ══ 运行形态 ═══════════════════════════════════════════════════════════
# profile 选 configs/<name>.yaml（默认 default）。开发期用 local：
# 它把 Qdrant 集合换成独立的 memories_dev，避免开发期的实验污染提交期的集合。
TIANXI_PROFILE=local
# 换一份配置目录（替代集合就靠它：TIANXI_CONFIG_DIR=configs/runs/<arm>）
# TIANXI_CONFIG_DIR=configs

# ⚠ **必须是 1**（§15）。Add 的按 session 串行化用的是【进程内】锁，多 worker 会
# **静默失效**——每个 worker 各有各的锁，同 session 的两个批次照旧并发，pair_idx 撞车。
# 除了这个变量，`--workers 4` 那条路也会被拦（见 common/config.py 的 assert_single_process）。
TIANXI_WORKERS=1

# ══ 提交链路模型（§2.3 规定，不可替换）═════════════════════════════════
# Embedding：只能用 text-embedding-v4（DashScope / 阿里云百炼，OpenAI 兼容模式）
TIANXI_EMBED_API_KEY=
TIANXI_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 相关组件：只能用 gpt-4o-mini
TIANXI_LLM_API_KEY=
TIANXI_LLM_BASE_URL=https://api.openai.com/v1

# Reranker 不作规定（§2.3 / §11.1）——它是唯一能自己投入算力的环节。
# ⚠ 它同时是**唯一位于提交链路关键路径上、又不被规则保证可用**的组件：
#   提交后检索服务必须能连到这台自建网关。因此服务**必须实现降级**——
#   端点失败或超时时退回未重排的 RRF 顺序，而不是报错或空手而归（D12）。
TIANXI_RERANKER_BASE_URL=https://memory2.021130.xyz/v1
TIANXI_RERANKER_API_KEY=
TIANXI_RERANKER_MODEL=Qwen3-Reranker-4B   # 2026-09-24 定；提交时不得更换（D12）

# ══ 开发期模型网关（自建，§12.1 R1 主动接受的偏离）═════════════════════
# 三个模型全部由自建网关远程服务；开发期**不进提交链路**，Step 5 后停止使用。
# ⚠ **名字对不上，要注意**：归档 pipeline 读的是 `ANSWER_*` / `JUDGE_*`（AML 公开仓的
#   `api_config.py` 就是 `os.environ.get("ANSWER_API_BASE")` 那种写法），**不是 `AML_*`**。
#   两组之间谁接一下（`AML_*` → 七个名字：在 .env 里直接写 ANSWER_*，还是让仓库内的
#   `api_config.py` 转一手）**尚未决定**——见文件末与 eval/harness/CLAUDE.md。
# ⚠ LLM 与 Embedding 在**同一 host、但 key 不同，别混用**。
AML_BASE_URL=https://memory2.021130.xyz/v1
AML_API_KEY=
AML_MODEL=                        # qwen3.5-9b（128K 上下文）

# 归档 pipeline 的裁判模型。原 readme 记 Qwen/Qwen3-14B；若网关只提供 9B，
# 裁判能力弱于官方——**但只要全部实验固定同一个裁判，§13 的相对对照仍然成立**。
AML_JUDGE_MODEL=
AML_JUDGE_BASE_URL=               # 留空则回落 AML_BASE_URL
AML_JUDGE_API_KEY=                # 留空则回落 AML_API_KEY
AML_JUDGE_VERSION=                # 归档 import 了但从不使用，随便填

AML_EMB_BASE_URL=https://memory2.021130.xyz/v1
AML_EMB_API_KEY=                  # ⚠ 与 AML_API_KEY 不同
# ⚠ **embedding 的模型名在 configs/*.yaml 的 `models.embedder`**，不在这里（③-d）：
#   它是 profile 之间唯一真正该变的东西，所以归配置文件——那才能 diff、能评审。

# ══ 存储 ═══════════════════════════════════════════════════════════════
# Qdrant 必须 server 模式（§6.3）：local 模式会**静默丢弃 payload 索引**，
# 而 user_id / session_id / event_time 三个筛选全部依赖 payload 索引。
# ⚠ 本值就是**开发机的 localhost**：检索服务与 Qdrant 都跑在本机（D12）。
#   走远程的是**模型**，不是向量库——本机仍需装 docker。
TIANXI_QDRANT_URL=http://localhost:6333
# 版本必须钉死（§7.3）：rrf 的 weights 需 ≥ v1.17.0。Docker 镜像 tag 与客户端同步钉。
TIANXI_QDRANT_IMAGE=qdrant/qdrant:v1.17.0

# SQLite 真源文件（§6.1）。**唯一的不可重建物**，随 run 归档。
# 注意是 var/ 不是 data/ —— 后者与只读归档 benchmark_data/ 容易混（见 var/README.md）。
TIANXI_SQLITE_PATH=var/tianxi.db
# 向量缓存目录（§7.2）。**必须落盘**，否则每次重启重付一遍 embedding。
# 缓存键是渲染文本哈希、【不含模型标识】——Step 5 切模型时要主动作废整个目录。
TIANXI_EMBED_CACHE_DIR=var/embed_cache

# ══ 代理评测（§12.2）══════════════════════════════════════════════════
# 归档是只读的（§12.3 第 8 条）。harness 只读，不写回此处。
#
# ⚠ 这是**数据路径的唯一入口**（D16）：代码中**不得硬编码** `benchmark_data/`
#   或 `eval/datasets/`。默认指向归档；本地开发把它指到开发数据集即可，例如：
#     TIANXI_BENCHMARK_DIR=eval/datasets/LoCoMo-Refined/data
#   （`eval/datasets/` 下的数据只用于开发与自测，**不是最终要跑的数据集**。）
TIANXI_BENCHMARK_DIR=benchmark_data
# LongMemEval 用 lme_s_cleaned.json 而不是 lme_test.json——
# 后者多出 1,230 个空 session，会污染按"20 条消息"切批的埋点逻辑（§6.5）。
# ⚠ `lme_test.json` **已于 2026-09-24 从归档删除**（它是个等着被误用的坑，见 docs/benchmark-data.md）。
# LoCoMo-Refined 全文取自 locomo_refined.json；questions.jsonl 只有证据轮、不是整段对话。

# ⚠ 不在本文件里的一个环境依赖：归档的 7 个 pipeline 都 `from api_config import (...)`，
#   而该模块【目前不存在】，五个 pipeline 今天都 import 失败。
#
#   处置（D12 后已简化）：**不要再在仓库外创建它。** 把 `api_config.py` 放在仓库内，
#   做成只读上面 AML_* 那组环境变量的 **7 行适配器**，由 harness 在 subprocess 里
#   注入 PYTHONPATH —— 因为 `sys.path.insert(0, <不存在路径>)` 只是塞进一个没有该模块
#   的条目，import 会继续往后找到 PYTHONPATH 里的那份。好处是归档保持只读、
#   `parents[2]` 那条脆弱路径被绕开、且配置只有 .env 一份。
#
#   ⚠ 那 7 个名字里**没有 embedding**——归档 pipeline 是纯 LLM 的 answer/judge 驱动，
#     不做任何向量化。Qwen3-Embedding-8B 的配置不经过 api_config，它只属于 src/tianxi_am。
#   见 eval/harness/CLAUDE.md 与 docs/roadmap.md。
