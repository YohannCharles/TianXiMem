# Environment template. Copy to .env and fill deployment-specific values.
# Secrets, endpoints, model IDs, paths, and process shape belong here.
# Thresholds and feature switches belong in configs/*.yaml.

# Selecting the active profile and optional config directory.
TIANXIMEM_PROFILE=local
# TIANXIMEM_CONFIG_DIR=configs
# TIANXIMEM_ENV_FILE=.env

# The application must run as one process.
TIANXIMEM_WORKERS=1

# Reranker endpoint. Reranking degrades to RRF order when this endpoint is unavailable.
TIANXIMEM_RERANKER_BASE_URL=https://memory.021130.xyz/v1
TIANXIMEM_RERANKER_API_KEY=
TIANXIMEM_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B

# Primary OpenAI-compatible chat endpoint used by the service.
AML_BASE_URL=https://memory.021130.xyz/v1
AML_API_KEY=
AML_MODEL=Qwen/Qwen3.5-9B

# Optional secondary chat endpoint used by evaluation judge workers.
AML_BASE_URL_2=https://memory2.021130.xyz/v1
AML_API_KEY_2=

# Judge overrides. Empty values inherit the selected chat endpoint.
AML_JUDGE_MODEL=
AML_JUDGE_BASE_URL=
AML_JUDGE_API_KEY=
AML_JUDGE_VERSION=

# OpenAI-compatible embedding endpoint. The model ID is in configs/*.yaml.
AML_EMB_BASE_URL=https://memory2.021130.xyz/v1
AML_EMB_API_KEY=

# Qdrant server. Use 127.0.0.1 rather than localhost to avoid IPv6 fallback latency.
TIANXIMEM_QDRANT_URL=http://127.0.0.1:6333
TIANXIMEM_QDRANT_IMAGE=qdrant/qdrant:v1.17.0

# Source of truth and persistent embedding cache.
TIANXIMEM_SQLITE_PATH=var/tianxi.db
TIANXIMEM_EMBED_CACHE_DIR=var/embed_cache

# Optional per-process metric snapshot.
# TIANXIMEM_METRICS_PATH=var/metrics.json

# Optional raw request capture. The enable switch is capture.enabled in YAML.
# TIANXIMEM_CAPTURE_PATH=var/capture/requests.jsonl

# Root of the local evaluation data.
TIANXIMEM_BENCHMARK_DIR=dataset
