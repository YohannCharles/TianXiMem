# Environment template. Copy to .env and fill deployment-specific values.

TIANXIMEM_PROFILE=local
# TIANXIMEM_CONFIG_DIR=configs
# TIANXIMEM_ENV_FILE=.env
TIANXIMEM_WORKERS=1

# OpenAI-compatible chat endpoint. Required by every profile except v1.0.
# The model is gpt-4o-mini; the endpoint and key have no usable default.
AML_BASE_URL=
AML_API_KEY=
AML_MODEL=gpt-4o-mini

# OpenAI-compatible embedding endpoint. Model ID is set in configs/*.yaml.
AML_EMB_BASE_URL=
AML_EMB_API_KEY=

# Reranker endpoint (required). Reranking is part of the required configuration;
# without the endpoint the service records rerank_disabled and returns RRF order.
# qwen3.7-text-rerank is the model used here; another reranker can replace it.
# The client posts to `{TIANXIMEM_RERANKER_BASE_URL}/rerank` by default. For a
# DashScope gateway set `rerank.envelope: dashscope` in configs/*.yaml; the client
# then uses the native `.../api/v1/services/rerank/text-rerank/text-rerank` path.
TIANXIMEM_RERANKER_BASE_URL=
TIANXIMEM_RERANKER_API_KEY=
TIANXIMEM_RERANKER_MODEL=qwen3.7-text-rerank

# Qdrant server. The image value is consumed by deploy/compose.yaml.
TIANXIMEM_QDRANT_URL=http://127.0.0.1:6333
TIANXIMEM_QDRANT_IMAGE=qdrant/qdrant:v1.17.0

# Source of truth and rebuildable embedding cache.
TIANXIMEM_SQLITE_PATH=var/tianxi.db
TIANXIMEM_EMBED_CACHE_DIR=var/embed_cache

# Optional metric snapshot path.
# TIANXIMEM_METRICS_PATH=var/metrics.json
