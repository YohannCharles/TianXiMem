# Container deployment environment.
#
# Copy to deploy/.env, then fill in the model endpoints:
#   cp deploy/.env.example deploy/.env
#
# Compose reads this file twice: as the interpolation source for
# deploy/compose.yaml (`${...}` below), and as the container's env_file.
# Values here are literal — Compose does not interpolate inside env_file.
#
# Never commit deploy/.env: it holds API keys.

# ── Image and build ────────────────────────────────────────────────────
# Used by compose to build/tag; both are optional.
TIANXIMEM_IMAGE=tianximem
TIANXIMEM_TAG=local

# Restricted-network alternatives. Commented out means "use the defaults"
# (python:3.12-slim-bookworm and https://pypi.org/simple).
# The mirror must serve the same artifacts; uv.lock pins pypi.org URLs.
# TIANXIMEM_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
# TIANXIMEM_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# TIANXIMEM_UV_VERSION=0.12.15

# ── Runtime profile ────────────────────────────────────────────────────
# Selects configs/<profile>.yaml. `default` is the product profile;
# `local` uses a separate collection and disables reranking.
TIANXIMEM_PROFILE=default

# Host publishing. The API has no built-in authentication: keep it on
# loopback, or terminate TLS and authentication at an ingress in front.
TIANXIMEM_BIND=127.0.0.1
TIANXIMEM_PORT=8000

# ── Qdrant ─────────────────────────────────────────────────────────────
# The application reaches Qdrant by service name inside the compose network.
# Set this only when pointing at an external Qdrant.
# TIANXIMEM_QDRANT_URL=http://qdrant:6333
TIANXIMEM_QDRANT_IMAGE=qdrant/qdrant:v1.17.0
TIANXIMEM_QDRANT_PORT=6333
TIANXIMEM_QDRANT_GRPC_PORT=6334

# ── Embedding (required) ───────────────────────────────────────────────
# OpenAI-compatible /embeddings endpoint. The model ID is chosen by
# configs/<profile>.yaml (`models.embedder`), not by an environment variable:
#   default / submit -> text-embedding-v4
# The service refuses to start without both values below.
AML_EMB_BASE_URL=
AML_EMB_API_KEY=

# ── Chat model (required by the default profile) ───────────────────────
# The default profile enables the query router and the multi-hop executor,
# each of which calls this endpoint. Validation fails at startup when either
# of them is enabled and these are empty.
# The competition requirement is gpt-4o-mini; keep it here so the running
# deployment matches what is declared.
AML_BASE_URL=
AML_API_KEY=
AML_MODEL=gpt-4o-mini

# ── Reranker (required) ────────────────────────────────────────────────
# `default` sets rerank.enabled: true and reranking is part of the required
# configuration. Fill in both endpoint values; without them the service logs a
# warning, records rerank_disabled, and returns RRF order instead of reranking.
# qwen3.7-text-rerank is the model this deployment uses; the endpoint is
# OpenAI-compatible, so another reranker can be substituted here.
# If the gateway only serves DashScope's native rerank path, set
# `rerank.envelope: dashscope` in configs/*.yaml; the client then calls
# `.../api/v1/services/rerank/text-rerank/text-rerank` with input.query/documents.
TIANXIMEM_RERANKER_BASE_URL=
TIANXIMEM_RERANKER_API_KEY=
TIANXIMEM_RERANKER_MODEL=qwen3.7-text-rerank

# ── Data paths inside the container ────────────────────────────────────
# Set by compose.yaml; listed here for readers. Every stateful file stays on
# the mounted volume, otherwise `docker compose down` drops the stored memories.
# TIANXIMEM_SQLITE_PATH=/data/tianxi.db
# TIANXIMEM_EMBED_CACHE_DIR=/data/embed_cache

# Metric snapshot. An empty value (the `-` form in compose) disables writing.
# Two comparison runs need separate services or separate paths.
TIANXIMEM_METRICS_PATH=/data/metrics.json
