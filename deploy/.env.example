# Container deployment environment. Copy to deploy/.env and fill secrets.

TIANXIMEM_PROFILE=default
TIANXIMEM_BIND=127.0.0.1
TIANXIMEM_PORT=8000

# Qdrant service address and published ports.
# TIANXIMEM_QDRANT_URL=http://qdrant:6333
# TIANXIMEM_QDRANT_PORT=6333
# TIANXIMEM_QDRANT_GRPC_PORT=6334

# Embedding endpoint.
AML_EMB_BASE_URL=
AML_EMB_API_KEY=

# Optional reranker endpoint. The service degrades to RRF order if unavailable.
TIANXIMEM_RERANKER_BASE_URL=
TIANXIMEM_RERANKER_API_KEY=
TIANXIMEM_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B

# Required when router or multi-hop execution is enabled.
AML_BASE_URL=
AML_API_KEY=
AML_MODEL=
