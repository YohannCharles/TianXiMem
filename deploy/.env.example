# TianXi_AM 服务端环境变量 —— **给 `deploy/compose.yaml` 用**
#
#     cp deploy/.env.example deploy/.env      # 然后填真值
#     docker compose -f deploy/compose.yaml up -d --build
#
# ⚠ `deploy/.env` **不进 git**（`.gitignore` 的 `.env` / `.env.*` 覆盖任意层级）。
# ⚠ **本文件同时干两件事**：① 被 `env_file` 注入容器；② 被 compose 用来做 `${...}` 插值
#   （`TIANXI_QDRANT_URL` / `TIANXI_PROFILE` / `TIANXI_BIND` 三项）。
#   所以它既是"容器的环境"，又是"这份 compose 的变量表"——**一处声明**，别拆成两份。
#
# ── 这一份与仓库根的 `.env.example` 的分工 ─────────────────────────────────
#
#   根 `.env.example`      **开发机全量**：服务 + harness + 归档 pipeline + 本地模型
#   本文件                 **服务器只留服务真正读的那几项**
#
# ⚠ **只有 [`../src/tianxi_am/common/config.py`](../src/tianxi_am/common/config.py) 读环境变量**
#   （有静态测试钉住）。本文件里出现的名字都在它的 `ENV_*` 表里，改这里要同步改那边。
#   **刻意不列** 面板模型 / judge / benchmark 路径那些——服务一个都不读，
#   写进来只会让人以为它们有用（那正是"配置项没有消费方"的那种坑）。

# ══ 运行形态 ═══════════════════════════════════════════════════════════
# profile 选 configs/<name>.yaml。**提交期必须是 default**（集合 memories）；
# 开发/自测用 local（集合 memories_dev，见 configs/CLAUDE.md 的隔离理由）。
# ⚠ 换集合名 = 换一个集合：上一套 point 会**静默留在旧集合里**（V9）。
TIANXI_PROFILE=default

# 服务在**宿主机**上绑哪个地址、哪个端口（容器内固定是 0.0.0.0:8000）。
#
#   TIANXI_BIND=127.0.0.1  只本机可访问（**默认**——本服务没有任何鉴权）
#   TIANXI_BIND=0.0.0.0    所有网卡（要让别的机器访问就得这样）
#
# ⚠ **只改端口不顶用**：绑在 127.0.0.1 上时，同机 `curl localhost:28088` 通、
#   从别的机器打过来是 connection refused，**而服务日志里什么都没有**。
# ⚠ 服务没有任何鉴权（`user_id` 是隔离字段不是认证）⇒ 对外暴露前先想清楚
#   在它前面放什么（反代鉴权 / IP 白名单 / 内网隔离）。
TIANXI_BIND=127.0.0.1
TIANXI_PORT=8000

# Qdrant 在**宿主机**上暴露的端口（默认只绑 127.0.0.1）。
# ⚠ Qdrant 本身**没有鉴权**，别绑到 0.0.0.0。应用走 compose 网络用 `qdrant:6333`，
#   根本不用这两个端口——它们只为宿主上的工具（tools/ 的脚本、开发环路）存在。
# TIANXI_QDRANT_PORT=6333
# TIANXI_QDRANT_GRPC_PORT=6334

# Qdrant 的地址（**给容器里那个进程用的**）。
# 留空/删掉这一行就用 compose 内置的那个（`http://qdrant:6333`）。
# 指外部 Qdrant 时才填，例如 http://10.193.135.28:6333。
# TIANXI_QDRANT_URL=

# ⚠ `TIANXI_WORKERS` / `TIANXI_SQLITE_PATH` / `TIANXI_EMBED_CACHE_DIR` **不在这里**
#   ——它们由 compose 的 `environment` 段固定成容器形态（单进程 + /data 卷里的路径）。
#   本文件里的同名键会被 compose 覆盖（`environment` 优先级高于 `env_file`）。

# ══ embedding（**必需**：缺了服务拒绝启动，见 validate()）═══════════════
# §2.3 规定只能用 text-embedding-v4（提交链路不可协商）。
# ⚠ **模型名不在这里**——它在 configs/<profile>.yaml 的 `models.embedder`（③-d 的两层分工）。
#
# ⚠⚠ **现在部署上去跑的不是提交口径。** `configs/submit.yaml` **还不存在**
#     （见根 CLAUDE.md 的状态表），`default.yaml` 的 `models.embedder` 是开发期的
#     `Qwen/Qwen3-Embedding-8B`。⇒ **这一步部署的用途是"服务能跑起来 / 能连通"**，
#     不是"这就是提交时的那套"。Step 5 才会同时换 embedding 与 LLM 两个模型，
#     并**重建整个集合**（换模型 = 换向量维度，见 deploy/CLAUDE.md §4 的 runbook）。
#
# ── ⚠⚠ 网关跑在**同一台机器**上时的地址怎么写（**最容易错的一处**）──────────
#
#   容器里的 `127.0.0.1` 是**容器自己**，不是宿主机。
#   ⇒ `http://127.0.0.1:9002/v1` 在容器里**必然失败**（那个端口上没人监听），
#     而且报的是 connection refused，看起来像"网关挂了"。
#
#   容器里"同机器"的三种正确写法，按优先级：
#
#     ① `http://host.docker.internal:9002/v1`
#        容器 → 宿主机。compose 里已经加了 `extra_hosts: host-gateway`。
#        **网关只绑 127.0.0.1 时这是唯一可行的写法**（下面两种都不行）。
#
#     ② `http://<宿主机网卡地址>:9002/v1`，例如 `http://10.193.135.28:9002/v1`
#        跨机器访问时也用这个。⚠ 前提是网关监听的不是 127.0.0.1。
#
#     ③ 不改地址、改用 `network_mode: host` 跑容器——**不推荐**：
#        那会绕过端口映射（`TIANXI_PORT` 就失效了），且这份 compose 在
#        Docker Desktop 上直接不能用。
#
#   ⚠ 走**跨机器**那条路时注意：`https` 要改成 `http`（内网网关通常没有证书），
#     `/v1` 保留。⛔ 别写成 `http://10.193.135.28:9002`（少了 `/v1`）——
#     那会 404，而 404 在第一次 Add 时才出现。
AML_EMB_BASE_URL=

# ⚠ 这个 Key 的**网关与下面 reranker 的不是同一个 host**（D18），**不能混用**。
#   与仓库根的 `.env.example` 里 `AML_EMB_*` 的语义一致（**以本仓为准**，见 D18）。
AML_EMB_API_KEY=

# ══ reranker（**可选**：缺了服务照常启动，走降级路径）══════════════════════
# §2.3 里**唯一不限模型**的组件，也是**唯一位于关键路径上、又不被规则保证可用**的那一个
# ⇒ 服务必须实现降级：端点失败或超时时退回未重排的 RRF 顺序，而不是报错（D12）。
# ⚠ 主网关（memory.021130.xyz），不是 memory2。
TIANXI_RERANKER_BASE_URL=
TIANXI_RERANKER_API_KEY=
# ⚠ 本值**只进 run record 的配置指纹**——端点是**忽略** `model` 字段的（实测）。
#   **不要拿它做路由或校验。**
TIANXI_RERANKER_MODEL=Qwen3-Reranker-4B
